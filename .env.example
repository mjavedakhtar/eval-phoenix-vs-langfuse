# Default for this lab: local Ollama, no cloud keys.
# Values: auto | ollama | azure | openai
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# Optional later — not required to start the lab.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phoenix — local, no account.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=data-fabric-agent

# Langfuse — local Docker. ./scripts/start-langfuse.sh then copy project keys.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
